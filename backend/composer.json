{
  "name": "portfolio/backend",
  "description": "Backend API for developer portfolio landing page",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.5",
    "phpmailer/phpmailer": "^6.9",
    "guzzlehttp/guzzle": "^7.8",
    "php-di/php-di": "^7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "zircote/swagger-php": "^4.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "php -S localhost:8080 -t public",
    "test": "phpunit"
  }
}
