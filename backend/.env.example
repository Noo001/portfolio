APP_ENV=development
APP_NAME=PortfolioBackend
APP_DEBUG=true

PORT=8080
FRONTEND_URL=http://localhost:4200

# Database (SQLite)
DATABASE_PATH=data/portfolio.sqlite

# Email (SMTP). Leave empty to disable real email sending and log messages instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PortfolioSite
OWNER_EMAIL=

# AI Provider (openai | stub)
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Rate limiting: max requests per window (seconds)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60
